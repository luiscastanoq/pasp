# Copia este archivo como .env.azure y sustituye todos los marcadores.
# .env.azure esta ignorado por Git y nunca debe subirse al repositorio.
DATABASE_URL="sqlserver://{TU_SERVIDOR_SQL}.database.windows.net:1433;database={TU_BASE_SQL};user={TU_USUARIO_SQL};password={TU_PASSWORD_SQL};encrypt=true;trustServerCertificate=false;schema=dbo"
