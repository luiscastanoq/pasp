# Entorno de ejecución: development, test o production.
NODE_ENV=development

# Puerto en el que escucha la API.
PORT=3001

# Origen autorizado por CORS para acceder al backend.
FRONTEND_URL=http://localhost:5173

# Conexión a Microsoft SQL Server utilizada por Prisma.
# Sustituye todos los marcadores por los datos del entorno local.
DATABASE_URL="sqlserver://SERVIDOR:1433;database=PASP;user=USUARIO;password=CONTRASENA;encrypt=true;trustServerCertificate=true"

# Secreto empleado para firmar los JWT.
# Sustituye este valor por una cadena larga, aleatoria y exclusiva del entorno.
JWT_SECRET=SUSTITUIR_POR_UN_SECRETO_LARGO_Y_ALEATORIO

# Tiempo de validez de los JWT.
JWT_EXPIRES_IN=2h
DEMO_JWT_EXPIRES_IN=30m

# Activar solo en la base dedicada a la demo, con la semilla ficticia cargada.
# Las cuentas ordinarias no escriben; el superadministrador conserva sus permisos.
PASP_DEMO_MODE=false
