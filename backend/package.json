{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --watch node_modules/ts-node/dist/bin.js --files src/server.ts",
    "dev:azure:demo": "node --env-file=.env.azure node_modules/ts-node/dist/bin.js --files src/server.ts",
    "build": "tsc",
    "postinstall": "prisma generate --schema=prisma/schema.prisma",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "migrate:create": "prisma migrate dev --schema=prisma/schema.prisma --create-only",
    "migrate:deploy": "prisma migrate deploy --schema=prisma/schema.prisma",
    "migrate:azure:status": "node --env-file=.env.azure node_modules/prisma/build/index.js migrate status --schema=prisma/schema.prisma",
    "migrate:azure:deploy": "node --env-file=.env.azure node_modules/prisma/build/index.js migrate deploy --schema=prisma/schema.prisma",
    "bootstrap:azure:admin": "node --env-file=.env.azure --env-file=.env.bootstrap -r ts-node/register src/seeds/bootstrapAdmin.ts",
    "seed:azure:demo:plan": "node --env-file=.env.azure --env-file=.env.seed.azure -r ts-node/register src/seeds/azureDemoSeed.ts plan",
    "seed:azure:demo:apply": "node --env-file=.env.azure --env-file=.env.seed.azure -r ts-node/register src/seeds/azureDemoSeed.ts apply",
    "seed:azure:demo:verify": "node --env-file=.env.azure --env-file=.env.seed.azure -r ts-node/register src/seeds/azureDemoSeed.ts verify",
    "e2e:db:migrate": "node --env-file=.env.e2e node_modules/prisma/build/index.js migrate deploy --schema=prisma/schema.prisma",
    "e2e:db:cleanup:fichajes": "node --env-file=.env.e2e node_modules/ts-node/dist/bin.js --files src/seeds/cleanupFichajesE2e.ts",
    "e2e:db:cleanup:tareas": "node --env-file=.env.e2e node_modules/ts-node/dist/bin.js --files src/seeds/cleanupTareasE2e.ts",
    "e2e:db:cleanup:evaluaciones": "node --env-file=.env.e2e node_modules/ts-node/dist/bin.js --files src/seeds/cleanupEvaluacionesE2e.ts",
    "e2e:server": "node --env-file=.env.e2e node_modules/ts-node/dist/bin.js --files src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.2",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.4.3"
  }
}
